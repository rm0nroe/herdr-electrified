+#[tokio::test]
+async fn warning_inside_stream_does_not_duplicate_answer_on_resize() -> Result<()> {
+    // Cover a notice between chunks and one arriving after the final chunk,
+    // before the authoritative completion event. Both must preserve the notice.
+    for warning_after_tail in [false, true] {
+        let mut app = make_test_app().await;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let prefix =
+            "1. A terminal accepts commands.\n2. It runs programs.\n3. It displays results.";
+        let warning = "Heads up, you have less than 25% of your weekly limit left.";
+        app.transcript_cells = vec![
+            plain_line_cell("earlier history"),
+            Arc::new(AgentMessageCell::new(
+                prefix.lines().map(Line::from).collect(),
+                /*is_first_line*/ true,
+            )),
+            Arc::new(history_cell::new_usage_warning_event(warning.to_string())),
+            Arc::new(AgentMessageCell::new(
+                vec![Line::from("DONE")],
+                /*is_first_line*/ false,
+            )),
+        ];
+        if warning_after_tail {
+            app.transcript_cells.swap(2, 3);
+        }
+        app.overlay = Some(Overlay::new_transcript(
+            app.transcript_cells.clone(),
+            crate::keymap::RuntimeKeymap::defaults().pager,
+            /*copy_on_select*/ false,
+        ));
+        app.handle_consolidate_agent_message(
+            &mut tui,
+            format!("{prefix}\n\nDONE"),
+            PathBuf::from("/tmp"),
+            /*inline_visualization_context*/ None,
+            crate::app_event::ConsolidationScrollbackReflow::IfResizeReflowRan,
+            /*deferred_history_cell*/ None,
+        )?;
+        assert!(app.transcript_reflow.has_pending_reflow());
+        for width in [120, 60, 120] {
+            let rendered = app
+                .render_transcript_lines_for_reflow(width)
+                .lines
+                .into_iter()
+                .map(|line| line.line.to_string())
+                .collect::<Vec<_>>()
+                .join("\n");
+            let Some(Overlay::Transcript(overlay)) = app.overlay.as_mut() else {
+                panic!("transcript overlay missing");
+            };
+            let area = ratatui::layout::Rect::new(0, 0, width, 30);
+            let mut buffer = ratatui::buffer::Buffer::empty(area);
+            overlay.render(area, &mut buffer);
+            let overlay_text = buffer
+                .content
+                .iter()
+                .map(ratatui::buffer::Cell::symbol)
+                .collect::<String>();
+            for text in [
+                "earlier history",
+                "A terminal accepts commands.",
+                "It runs programs.",
+                "It displays results.",
+                "DONE",
+                "Heads up",
+            ] {
+                assert_eq!(
+                    rendered.matches(text).count(),
+                    1,
+                    "width {width}: {rendered}"
+                );
+                assert_eq!(
+                    overlay_text.matches(text).count(),
+                    1,
+                    "overlay width {width}: {overlay_text}"
+                );
+            }
+        }
+    }
+    Ok(())
+}
