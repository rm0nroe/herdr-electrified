+#[test]
+fn herdr_transcript_colors_spacing_and_reflow() {
+    let reference = crate::style::herdr_reference_ui();
+    let user = new_user_prompt("one\n\ntwo".into(), vec![], vec![], vec![]);
+    let user_lines = user.display_lines(40);
+    assert_eq!(user_lines.len(), if reference { 3 } else { 5 });
+    let markdown = AgentMarkdownCell::new(
+        "## Electric\n\nBody **strong**\n\n1. Ordered\n2. Second\n\n- Unordered\n\n`code`\n\n> Quoted words wrap onto a second line.\n>\n> > Nested quote\n\n```python\nprint(1)\n\nprint(2)\n```\n\n```\nplain code\n```\n\nAfter code".into(),
+        Path::new("/tmp"),
+    );
+    let wide = markdown.display_lines(40);
+    let narrow = markdown.display_lines(16);
+    assert_eq!(markdown.display_lines(40), wide);
+    assert!(narrow.iter().all(|line| line.width() <= 16));
+    if reference {
+        assert_eq!(user_lines[0].style.bg, Some(Color::Rgb(17, 17, 27)));
+        let link_lines =
+            AgentMarkdownCell::new("[link](https://example.com)".into(), Path::new("/tmp"))
+                .display_lines(60);
+        let spans: Vec<_> = wide
+            .iter()
+            .chain(&link_lines)
+            .flat_map(|line| {
+                line.spans
+                    .iter()
+                    .map(|span| span.clone().style(line.style.patch(span.style)))
+            })
+            .collect();
+        assert!(spans.iter().any(|span| span.content.contains("Body")
+            && span.style.fg == Some(crate::style::ELECTRIC_TEXT)
+            && !span.style.add_modifier.contains(Modifier::DIM)));
+        assert!(spans.iter().any(|span| span.content.contains("1.")
+            && span.style.fg == Some(crate::style::ELECTRIC_PINK)));
+        assert!(spans.iter().any(
+            |span| span.content == "code" && span.style.fg == Some(crate::style::ELECTRIC_CYAN)
+        ));
+        assert!(spans.iter().any(|span| span.content.contains("Electric")
+            && span.style.fg == Some(crate::style::ELECTRIC_PINK)));
+        assert!(spans.iter().any(|span| span.content.contains("link")
+            && span.style.fg == Some(crate::style::ELECTRIC_CYAN)
+            && span.style.add_modifier.contains(Modifier::UNDERLINED)));
+        for line in &wide {
+            let text = line.to_string();
+            if text.contains("Quoted") || text.contains("Nested") {
+                assert_eq!(line.style.fg, Some(crate::style::ELECTRIC_TEXT));
+                assert!(
+                    line.spans
+                        .iter()
+                        .filter(|span| span.content.contains('>'))
+                        .all(|span| span.style.fg == Some(crate::style::ELECTRIC_CYAN))
+                );
+            }
+            if text.contains("print(") || text.contains("plain code") {
+                assert_eq!(line.style.bg, Some(crate::style::ELECTRIC_SURFACE));
+            }
+            if text.contains("After code") {
+                assert_eq!(line.style.bg, None);
+            }
+        }
+        let streamed = AgentMessageCell::new(wide.clone(), true).display_lines(60);
+        assert_eq!(
+            streamed[0].spans[0].style.fg,
+            Some(crate::style::ELECTRIC_PINK)
+        );
+    }
+    let mut lines = user_lines;
+    lines.push(Line::default());
+    lines.extend(wide);
+    let mut buffer = ratatui::buffer::Buffer::empty(ratatui::layout::Rect::new(0, 0, 40, 34));
+    ratatui::widgets::Widget::render(
+        ratatui::widgets::Paragraph::new(lines),
+        buffer.area,
+        &mut buffer,
+    );
+    if reference {
+        for y in [20, 21, 22, 24] {
+            for x in 0..40 {
+                assert_eq!(buffer[(x, y)].bg, crate::style::ELECTRIC_SURFACE);
+            }
+        }
+        assert_eq!(buffer[(0, 26)].bg, ratatui::style::Color::Reset);
+    }
+    insta::assert_snapshot!(
+        if reference {
+            "herdr_transcript_reference"
+        } else {
+            "herdr_transcript_standard"
+        },
+        format!("{buffer:?}")
+    );
+}
