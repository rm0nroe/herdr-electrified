+#[tokio::test]
+async fn herdr_bottom_layout_keeps_content_above_composer_popups_and_approval() {
+    use crate::bottom_pane::ApprovalRequest;
+    use crate::bottom_pane::ExecApprovalRequest;
+    use crate::bottom_pane::SelectionItem;
+    use crate::bottom_pane::SelectionViewParams;
+    use crate::test_backend::VT100Backend;
+    use codex_app_server_protocol::CommandExecutionApprovalDecision;
+
+    let (mut widget, _sender, _events, _operations) = make_chatwidget_manual_with_sender().await;
+    widget.bottom_pane.enable_herdr_reference_ui_for_test();
+    widget.transcript.active_cell = Some(Box::new(history_cell::PlainHistoryCell::new(vec![
+        "active output".into(),
+    ])));
+    let mut terminal =
+        crate::custom_terminal::Terminal::with_options(VT100Backend::new(80, 24)).unwrap();
+    let area = Rect::new(0, 0, 80, 24);
+    terminal.set_viewport_area(area);
+    let mut captures = Vec::new();
+    for phase in ["startup", "multiline", "popup", "approval"] {
+        match phase {
+            "startup" => {
+                widget
+                    .bottom_pane
+                    .set_composer_text("input marker".into(), Vec::new(), Vec::new())
+            }
+            "multiline" => widget.bottom_pane.set_composer_text(
+                "line one\nline two\ninput marker".into(),
+                Vec::new(),
+                Vec::new(),
+            ),
+            "popup" => widget.bottom_pane.show_selection_view(SelectionViewParams {
+                view_id: Some("herdr-layout-test"),
+                title: Some("Select an option".into()),
+                items: vec![SelectionItem {
+                    name: "Choice marker".into(),
+                    ..Default::default()
+                }],
+                ..Default::default()
+            }),
+            "approval" => {
+                assert!(widget.bottom_pane.dismiss_view_by_id("herdr-layout-test"));
+                widget.bottom_pane.push_approval_request(
+                    ApprovalRequest::Exec(ExecApprovalRequest {
+                        kind: Default::default(),
+                        thread_id: codex_protocol::ThreadId::new(),
+                        thread_label: None,
+                        id: "layout-approval".into(),
+                        environment_id: None,
+                        command: vec!["echo".into(), "approval marker".into()],
+                        reason: None,
+                        available_decisions: vec![
+                            CommandExecutionApprovalDecision::Accept,
+                            CommandExecutionApprovalDecision::Cancel,
+                        ],
+                        network_approval_context: None,
+                        additional_permissions: None,
+                    }),
+                    &codex_features::Features::default(),
+                );
+            }
+            _ => unreachable!(),
+        }
+        terminal
+            .draw(|frame| {
+                let renderable = widget.as_renderable();
+                renderable.render(area, frame.buffer_mut());
+                if let Some(cursor) = renderable.cursor_pos(area) {
+                    frame.set_cursor_position(cursor);
+                }
+            })
+            .unwrap();
+        let screen = terminal.backend().vt100().screen();
+        let rows: Vec<_> = screen.rows(0, 80).collect();
+        assert!(rows[1].contains("active output"));
+        if matches!(phase, "startup" | "multiline") {
+            let input_row = rows
+                .iter()
+                .position(|row| row.contains("input marker"))
+                .unwrap();
+            assert!(
+                input_row >= 20,
+                "composer must be near the bottom: {rows:?}"
+            );
+            assert_eq!(usize::from(screen.cursor_position().0), input_row);
+        }
+        captures.push(format!("{phase}:\n{}", screen.contents()));
+    }
+    insta::assert_snapshot!(captures.join("\n\n"));
+}
