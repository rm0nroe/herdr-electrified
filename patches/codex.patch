@@ -0,0 +1,207 @@
+use super::*;
+use crate::insert_history::insert_history_lines;
+use crate::test_backend::VT100Backend;
+use pretty_assertions::assert_eq;
+use ratatui::layout::Rect;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+
+fn draw(terminal: &mut Terminal<VT100Backend>, height: u16, alignment: ViewportAlignment) {
+    let size = terminal.backend().size().unwrap();
+    alignment
+        .update(terminal, height, size, ScrollbackStrategy::Standard)
+        .unwrap();
+    terminal.invalidate_viewport();
+    terminal
+        .draw_with_size(size, |frame| {
+            let viewport = frame.area();
+            let area = Rect::new(
+                0,
+                viewport.bottom() - 3.min(viewport.height),
+                viewport.width,
+                3.min(viewport.height),
+            );
+            frame.render_widget_ref(&Paragraph::new("> input"), area);
+            frame.set_cursor_position((2, area.y));
+        })
+        .unwrap();
+}
+
+#[test]
+fn bottom_startup_and_completed_turn() {
+    let mut terminal = Terminal::with_options(VT100Backend::with_scrollback(24, 10, 64)).unwrap();
+    draw(&mut terminal, 3, ViewportAlignment::Bottom);
+    assert_eq!(terminal.viewport_area, Rect::new(0, 0, 24, 10));
+    insert_history_lines(
+        &mut terminal,
+        vec![Line::from("user turn"), Line::from("assistant answer")],
+    )
+    .unwrap();
+    draw(&mut terminal, 3, ViewportAlignment::Bottom);
+    assert_eq!(
+        terminal.backend().vt100().screen().cursor_position(),
+        (7, 2)
+    );
+    insta::assert_snapshot!(terminal.backend().vt100().screen().contents().lines().map(str::trim_end).collect::<Vec<_>>().join("\n"), @r"
+    user turn
+    assistant answer
+
+
+
+
+
+    > input
+    ");
+}
+
+#[test]
+fn bottom_multiline_growth_and_collapse_preserve_history_once() {
+    let mut terminal = Terminal::with_options(VT100Backend::with_scrollback(24, 12, 64)).unwrap();
+    draw(&mut terminal, 3, ViewportAlignment::Bottom);
+    insert_history_lines(
+        &mut terminal,
+        vec![Line::from("history A"), Line::from("history B")],
+    )
+    .unwrap();
+    for height in [6, 3, 8, 3] {
+        draw(&mut terminal, height, ViewportAlignment::Bottom);
+        let screen = terminal.backend().vt100().screen();
+        assert_eq!(terminal.viewport_area.bottom(), 12);
+        for marker in ["history A", "history B", "> input"] {
+            assert_eq!(screen.contents().matches(marker).count(), 1);
+        }
+        let rows: Vec<_> = screen.rows(0, 24).collect();
+        assert_eq!(rows[0], "history A");
+        assert_eq!(rows[1], "history B");
+    }
+}
+
+#[test]
+fn inline_startup_keeps_shell_cursor_anchor() {
+    let mut terminal =
+        Terminal::with_options_and_cursor_position(VT100Backend::new(24, 10), Position::new(0, 2))
+            .unwrap();
+    draw(&mut terminal, 3, ViewportAlignment::Inline);
+    assert_eq!(terminal.viewport_area, Rect::new(0, 2, 24, 3));
+}
+
+fn complete_history(terminal: &Terminal<VT100Backend>) -> Vec<String> {
+    let mut screen = terminal.backend().vt100().screen().clone();
+    let width = screen.size().1;
+    screen.set_scrollback(usize::MAX);
+    let mut rows = Vec::new();
+    for offset in (1..=screen.scrollback()).rev() {
+        screen.set_scrollback(offset);
+        rows.push(screen.rows(0, width).next().unwrap());
+    }
+    screen.set_scrollback(0);
+    rows.extend(screen.rows(0, width));
+    rows
+}
+
+#[test]
+fn bottom_overflow_and_resume_keep_each_history_row_once() {
+    use crate::insert_history::HistoryLineWrapPolicy;
+    use crate::insert_history::insert_history_lines_with_mode_and_wrap_policy;
+    for strategy in [ScrollbackStrategy::Standard, ScrollbackStrategy::FullScreen] {
+        for batch_size in [1, 40] {
+            let mut terminal =
+                Terminal::with_options(VT100Backend::with_scrollback(24, 10, 100)).unwrap();
+            draw(&mut terminal, 3, ViewportAlignment::Bottom);
+            let expected: Vec<_> = (0..40).map(|i| format!("history-{i:02}")).collect();
+            for batch in expected.chunks(batch_size) {
+                insert_history_lines_with_mode_and_wrap_policy(
+                    &mut terminal,
+                    batch.iter().cloned().map(Line::from).collect(),
+                    strategy.history_insertion_mode(HistoryLineWrapPolicy::PreWrap),
+                    HistoryLineWrapPolicy::PreWrap,
+                )
+                .unwrap();
+                draw(&mut terminal, 3, ViewportAlignment::Bottom);
+            }
+            for height in [6, 3, 7, 3] {
+                draw(&mut terminal, height, ViewportAlignment::Bottom);
+            }
+            let rows = complete_history(&terminal);
+            assert_eq!(
+                rows.iter()
+                    .filter(|row| row.starts_with("history-"))
+                    .cloned()
+                    .collect::<Vec<_>>(),
+                expected
+            );
+            assert_eq!(rows.iter().filter(|row| row.contains("> input")).count(), 1);
+            assert_eq!(
+                terminal.backend().vt100().screen().cursor_position(),
+                (7, 2)
+            );
+        }
+    }
+}
+
+#[test]
+fn bottom_resize_replay_retains_history_and_bottom_cursor() {
+    let mut terminal = Terminal::with_options(VT100Backend::with_scrollback(24, 12, 100)).unwrap();
+    draw(&mut terminal, 3, ViewportAlignment::Bottom);
+    let source = vec![
+        Line::from("first history row"),
+        Line::from("second history row"),
+    ];
+    insert_history_lines(&mut terminal, source.clone()).unwrap();
+    for size in [Size::new(24, 8), Size::new(32, 16), Size::new(12, 12)] {
+        terminal.backend_mut().set_size(size);
+        // Match source-backed reflow: purge rendered rows, reset insertion y, replay once.
+        terminal.clear_scrollback_and_visible_screen_ansi().unwrap();
+        let mut area = terminal.viewport_area;
+        area.y = 0;
+        terminal.set_viewport_area(area);
+        ViewportAlignment::Bottom
+            .update(&mut terminal, 3, size, ScrollbackStrategy::Standard)
+            .unwrap();
+        crate::insert_history::insert_history_hyperlink_lines_with_mode_and_wrap_policy(
+            &mut terminal,
+            &crate::terminal_hyperlinks::plain_hyperlink_lines(source.clone()),
+            crate::insert_history::InsertHistoryMode::Standard,
+            crate::insert_history::HistoryLineWrapPolicy::PreWrap,
+            size,
+        )
+        .unwrap();
+        draw(&mut terminal, 3, ViewportAlignment::Bottom);
+        let rows = complete_history(&terminal).join("\n");
+        assert_eq!(rows.matches("first").count(), 1);
+        assert_eq!(rows.matches("second").count(), 1);
+        assert_eq!(rows.matches("> input").count(), 1);
+        assert_eq!(terminal.viewport_area.bottom(), size.height);
+        assert_eq!(
+            terminal.backend().vt100().screen().cursor_position(),
+            (size.height - 3, 2)
+        );
+    }
+}
+
+#[test]
+fn bottom_tiny_screen_preserves_history_outside_full_height_composer() {
+    for height in [1, 2, 3, 4] {
+        let mut terminal =
+            Terminal::with_options(VT100Backend::with_scrollback(24, height, 64)).unwrap();
+        draw(&mut terminal, 3, ViewportAlignment::Bottom);
+        insert_history_lines(
+            &mut terminal,
+            vec![Line::from("tiny history A"), Line::from("tiny history B")],
+        )
+        .unwrap();
+        draw(&mut terminal, 3, ViewportAlignment::Bottom);
+        let rows = complete_history(&terminal).join("\n");
+        assert_eq!(
+            rows.matches("tiny history A").count(),
+            1,
+            "{height}: {rows}"
+        );
+        assert_eq!(
+            rows.matches("tiny history B").count(),
+            1,
+            "{height}: {rows}"
+        );
+        assert_eq!(rows.matches("> input").count(), 1, "{height}: {rows}");
+    }
+}
