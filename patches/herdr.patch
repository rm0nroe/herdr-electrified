+#[test]
+fn sidebar_padding_insets_text_but_keeps_full_width_hit_targets() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("expanded sidebar").frame;
+    let rows = frame_rows(&frame);
+
+    assert!(rows[0].starts_with("  spaces"), "{:?}", rows[0]);
+    let card = state.hits.workspaces[0].rect;
+    assert_eq!(card.x, 0);
+    assert!(rows[card.y as usize].starts_with("  "), "{:?}", rows[card.y as usize]);
+    assert!(rows.iter().any(|row| row.starts_with("  agents")));
+}
+
+#[test]
+fn hidden_sidebar_controls_remove_footer_and_toggle_hit_targets() {
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.hide_controls = true;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    let frame = state.compose(106, 30).expect("expanded sidebar").frame;
+    let rows = frame_rows(&frame);
+
+    assert_eq!(state.hits.new_workspace, Rect::default());
+    assert_eq!(state.hits.global_launcher, Rect::default());
+    assert_eq!(state.hits.sidebar_toggle, Rect::default());
+    assert!(rows.iter().all(|row| !row.contains(" new") && !row.contains('«')));
+}
