+fn host_terminal_color_sequence(theme: &crate::terminal_theme::TerminalTheme) -> String {
+    use crate::terminal_theme::{osc_set_default_color_sequence, DefaultColorKind};
+    // One blue step off the pane color (invisible): Ghostty only extends an edge row
+    // into the padding when none of its cells match the host default background.
+    let mut sequence = theme
+        .background
+        .map(|bg| {
+            let host_bg = crate::terminal_theme::RgbColor { b: bg.b ^ 1, ..bg };
+            osc_set_default_color_sequence(DefaultColorKind::Background, host_bg)
+        })
+        .unwrap_or_default();
+    if let Some(fg) = theme.foreground {
+        sequence.push_str(&format!(
+            "\x1b]12;rgb:{:02x}/{:02x}/{:02x}\x1b\\",
+            fg.r, fg.g, fg.b
+        ));
+    }
+    sequence
+}
